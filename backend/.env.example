# --- Database (MySQL) ---
DATABASE_URL=mysql+pymysql://meeting:meeting@localhost:3306/meetings

# --- Vector store ---
CHROMA_PATH=./chroma_data

# --- Embeddings: auto | sentence-transformers | hash ---
# auto = try all-MiniLM-L6-v2, fall back to the offline hash embedder if it can't load
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM (leave GROQ_API_KEY empty to run in offline/heuristic mode) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Retrieval ---
CHUNK_WORDS=200
CHUNK_OVERLAP_WORDS=40
TOP_K=6
# MIN_SIMILARITY=0.25   # optional override

CORS_ORIGINS=http://localhost:5173
